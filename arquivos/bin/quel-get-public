#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
    echo "ERRO: Execute como root."
    exit 1
fi

if [ -z "$1" ]; then
    echo "Uso: quel-get-public <pacote>"
    exit 1
fi

PACKAGE_NAME=$1
DOWNLOAD_PATH="/tmp/${PACKAGE_NAME}.quel"

download_successful=false

while IFS= read -r REPO_URL; do

    [ -z "$REPO_URL" ] && continue

    PACKAGE_URL="${REPO_URL}/${PACKAGE_NAME}.quel"

    wget -q --timeout=10 -O "${DOWNLOAD_PATH}" "${PACKAGE_URL}"

    if [ $? -eq 0 ] && [ -s "${DOWNLOAD_PATH}" ]; then
        download_successful=true
        break
    fi

    rm -f "${DOWNLOAD_PATH}"

done < /etc/quel/repo-pub

if ! $download_successful; then
    echo "ERRO: Pacote não encontrado."
    exit 1
fi

echo "${DOWNLOAD_PATH}"