#!/bin/bash

######################################################################
# Autor     :   Ezequiel Carvalho <queldevelopment@gmail.com>        #
# Licença   :   MIT                                                  #
# Descrição :   Instalador de pacotes da distribuição Quieux Linux   #
######################################################################

AUTO_YES=${AUTO_YES:-0}

# Deve ser executado como root
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Este script precisa ser executado como root."
        exit 1
    fi
}

# Função para descompactar o pacote
extract_package() {
    local package_path=$1
    local package_name
    package_name=$(basename "$package_path" .quel)
    local tmp_dir="/tmp/$package_name"

    mkdir -p "$tmp_dir"

    unsquashfs -f -d "$tmp_dir" "$package_path" >/dev/null 2>&1

    if [ $? -ne 0 ]; then
        echo "ERRO: Falha ao descompactar pacote."
        exit 1
    fi

    # Exibe informações do pacote
    if [ -d "$tmp_dir/info" ]; then
        for desc_file in "$tmp_dir/info/"*; do
            [ -f "$desc_file" ] && cat "$desc_file"
        done
    fi
}

# Função para instalar o pacote
install_package() {
    local package_path=$1
    local package_name
    package_name=$(basename "$package_path" .quel)
    local tmp_dir="/tmp/$package_name"

    if [ "$AUTO_YES" != "1" ]; then
        read -p "Deseja continuar com a instalação? (S/N): " response

        if [[ "$response" != "S" && "$response" != "s" ]]; then
            rm -rf "$tmp_dir"
            echo "Instalação cancelada."
            exit 0
        fi
    fi

    cp -r "$tmp_dir"/* /

    if [ $? -ne 0 ]; then
        echo "ERRO: Falha na instalação."
        rm -rf "$tmp_dir"
        exit 1
    fi

    # Ajusta permissões
    if [ -f "/quel/$package_name" ]; then
        while IFS= read -r file; do
            [ -n "$file" ] && chmod 777 "/$file"
        done < "/quel/$package_name"
    fi

    rm -rf "$tmp_dir"

    echo "Pacote instalado com sucesso."
}

# Função para remover pacote
remove_package() {
    local package_name=$1

    if [ ! -f "/quel/$package_name" ]; then
        echo "Pacote não instalado."
        exit 1
    fi

    if [ "$AUTO_YES" != "1" ]; then
        read -p "Deseja remover $package_name? (S/N): " response

        if [[ "$response" != "S" && "$response" != "s" ]]; then
            echo "Remoção cancelada."
            exit 0
        fi
    fi

    while IFS= read -r file || [ -n "$file" ]; do
        [ -n "$file" ] && rm -f "$file"
    done < "/quel/$package_name"

    rm -f "/quel/$package_name"

    echo "Pacote removido com sucesso."
}

# Atualiza arquivos de repositório
update_repo_file() {
    local repo_url="https://quieux.github.io/update"
    local repo_pub_url="https://quieux.github.io/update-pub"

    wget -q "$repo_url" -O "/etc/quel/repo"

    if [ $? -ne 0 ]; then
        echo "ERRO: Falha ao atualizar repositório."
        exit 1
    fi

    wget -q "$repo_pub_url" -O "/etc/quel/repo-pub"

    if [ $? -ne 0 ]; then
        echo "ERRO: Falha ao atualizar repositório público."
        exit 1
    fi

    echo "Repositórios atualizados."
}

# Lista pacotes disponíveis
list_packages() {
    local repo_file="/etc/quel/repo"

    while IFS= read -r REPO_URL; do
        [ -z "$REPO_URL" ] && continue

        wget -qO- "$REPO_URL/" 2>/dev/null | \
        grep -oE '[a-zA-Z0-9._+-]+\.quel' | \
        sed 's/\.quel$//'

    done < "$repo_file" | sort -u
}

# Lista pacotes públicos
list_public_packages() {
    local repo_file="/etc/quel/repo-pub"

    while IFS= read -r REPO_URL; do
        [ -z "$REPO_URL" ] && continue

        wget -qO- "$REPO_URL/" 2>/dev/null | \
        grep -oE '[a-zA-Z0-9._+-]+\.quel' | \
        sed 's/\.quel$//'

    done < "$repo_file" | sort -u
}

# Download pacote normal
download_package() {
    local package_name=$1
    local package_path="/tmp/${package_name}.quel"

    quel-get "$package_name"

    if [ $? -ne 0 ]; then
        echo "ERRO: Pacote não encontrado."
        exit 1
    fi

    if [ ! -f "$package_path" ]; then
        echo "ERRO: Download falhou."
        exit 1
    fi

    AUTO_YES=1 quel -i "$package_path"
}

# Download pacote público
download_public_package() {
    local package_name=$1
    local package_path="/tmp/${package_name}.quel"

    quel-get-public "$package_name"

    if [ $? -ne 0 ]; then
        echo "ERRO: Pacote público não encontrado."
        exit 1
    fi

    if [ ! -f "$package_path" ]; then
        echo "ERRO: Download falhou."
        exit 1
    fi

    AUTO_YES=1 quel -i "$package_path"
}

# Root
check_root

# Verifica argumentos
if [ "$#" -lt 1 ]; then
    echo "Uso:"
    echo "  quel -i <arquivo.quel>"
    echo "  quel -r <pacote>"
    echo "  quel -u"
    echo "  quel -d <pacote>"
    echo "  quel -pub <pacote>"
    echo "  quel -l"
    echo "  quel -lp"
    exit 1
fi

# Comandos
case $1 in

    -i)
        [ -z "$2" ] && exit 1
        extract_package "$2"
        install_package "$2"
        ;;

    -r)
        [ -z "$2" ] && exit 1
        remove_package "$2"
        ;;

    -u)
        update_repo_file
        ;;

    -d)
        [ -z "$2" ] && exit 1
        download_package "$2"
        ;;

    -pub)
        [ -z "$2" ] && exit 1
        download_public_package "$2"
        ;;

    -l)
        list_packages
        ;;

    -lp)
        list_public_packages
        ;;

    *)
        echo "Comando inválido."
        exit 1
        ;;
esac